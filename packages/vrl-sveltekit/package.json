  "type": "module",
  "description": "SvelteKit load helpers for rendering VRL diagrams.",
  "license": "MIT",
  "author": {
    "name": "Pedro Guzmán"
  },
  "maintainers": [
    {
      "name": "Pedro Guzmán"
    }
  ],
  "homepage": "https://github.com/OneTesseractInMultiverse/vrl/tree/main/packages/vrl-sveltekit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneTesseractInMultiverse/vrl.git",
    "directory": "packages/vrl-sveltekit"
  },
  "bugs": {
    "url": "https://github.com/OneTesseractInMultiverse/vrl/issues"
  },
  "keywords": [
    "vrl",
    "sveltekit",
    "svelte",
    "canyoning",
    "canyoneering",
    "barranquismo",
